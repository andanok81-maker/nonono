--// Hàm chuyển tiếp mượt từ Key System sang Main Menu sau khi xác thực thật thành công
local function TransitionToMainMenu(expiryText)
    AppState.Authenticated = true
    AppState.LicenseStatus = "Đã kích hoạt"
    AppState.LicenseExpiry = expiryText or "Vĩnh viễn / Không giới hạn"

    MainWindow.FooterExpiry.Text = AppState.LicenseExpiry
    LicenseExpireHomeLbl:SetText("Thời gian sử dụng còn lại: " .. AppState.LicenseExpiry)
    LicenseStatusLbl:SetText("Trạng thái bản quyền: Đã kích hoạt hợp lệ")
    InfoLicenseLbl:SetText("Thông tin bản quyền: Hợp lệ (" .. AppState.LicenseExpiry .. ")")

    -- Animation ẩn Key System
    TweenObj(KeyScale, { Scale = 0.05 }, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    TweenObj(KeyFrame, { BackgroundTransparency = 1 }, 0.3)
    task.wait(0.34)
    if KeyFrame then KeyFrame:Destroy() end

    -- Animation mở Main Menu
    MainWindow.MainFrame.Visible = true
    MainWindow.MainScale.Scale = AppState.UiScale * 0.85
    TweenObj(MainWindow.MainScale, { Scale = AppState.UiScale }, 0.35, Enum.EasingStyle.Back)
    ApplyCharacterProperties(LocalPlayer.Character)
end

--// Xử lý xác thực API thật khi bấm ĐĂNG NHẬP
local function VerifyLicenseKey()
    if isVerifying then return end

    local rawKey = KeyBox.Text or ""
    local cleanKey = rawKey:gsub("^%s*(.-)%s*$", "%1")

    if cleanKey == "" then
        ServerStatusLbl.Text = "Server Status: WAITING FOR VERIFICATION"
        ServerStatusLbl.TextColor3 = Color3.fromRGB(245, 158, 11)
        CreateNotification("Thiếu thông tin", "Vui lòng nhập key!", "Cảnh báo", 3)
        return
    end

    isVerifying = true
    LoginBtn.Text = "ĐANG XÁC MINH..."
    ServerStatusLbl.Text = "Server Status: VERIFYING..."
    ServerStatusLbl.TextColor3 = Color3.fromRGB(96, 165, 250)
    CreateNotification("Xác thực hệ thống", "Đang xác minh key...", "Thông tin", 2.5)

    local hwid = GetHardwareId()
    local encodedKey = HttpService:UrlEncode(cleanKey)
    local encodedHwid = HttpService:UrlEncode(hwid)
    local requestUrl = string.format("%s?key=%s&hwid=%s", ANDZ_CONFIG.ApiEndpoint, encodedKey, encodedHwid)

    task.spawn(function()
        local ok, response = SendHttpRequest(requestUrl, "GET", {
            ["Accept"] = "application/json",
            ["User-Agent"] = "ANDZ-PREMIUM-CLIENT/2.4"
        })

        isVerifying = false
        LoginBtn.Text = "ĐĂNG NHẬP"

        if not ok or not response or not response.Body then
            ServerStatusLbl.Text = "Server Status: CONNECTION ERROR"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(239, 68, 68)
            CreateNotification("Lỗi kết nối", "Không thể kết nối máy chủ!", "Thất bại", 4)
            return
        end

        local parseOk, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not parseOk or type(data) ~= "table" then
            ServerStatusLbl.Text = "Server Status: CONNECTION ERROR"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(239, 68, 68)
            CreateNotification("Lỗi dữ liệu", "Không thể kết nối máy chủ!", "Thất bại", 4)
            return
        end

        -- Phân tích phản hồi JSON thực tế từ server
        local statusStr = tostring(data.status or data.state or ""):lower()
        local msgStr = tostring(data.message or data.msg or ""):lower()
        local isSuccess = (data.success == true)
            or (data.valid == true)
            or (statusStr == "success")
            or (statusStr == "valid")
            or (statusStr == "active")
            or (statusStr == "ok")

        local isExpired = (data.expired == true)
            or (statusStr == "expired")
            or (msgStr:find("expir") ~= nil)
            or (msgStr:find("hết hạn") ~= nil)

        local expiryValue = data.expires_at or data.expiry or data.expire or data.time_left or data.remaining or "Không giới hạn"

        if isSuccess and not isExpired then
            AppState.LicenseKey = cleanKey
            ServerStatusLbl.Text = "Server Status: CONNECTED"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(34, 197, 94)
            LicenseExpLbl.Text = "License Expiration: " .. tostring(expiryValue)
            LicenseExpLbl.TextColor3 = Color3.fromRGB(74, 222, 128)

            CreateNotification("Xác thực thành công", "Đăng nhập thành công!", "Thành công", 3.5)
            task.wait(0.75)
            TransitionToMainMenu(tostring(expiryValue))
        elseif isExpired then
            ServerStatusLbl.Text = "Server Status: KEY EXPIRED"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(245, 158, 11)
            LicenseExpLbl.Text = "License Expiration: " .. tostring(expiryValue)
            LicenseExpLbl.TextColor3 = Color3.fromRGB(251, 191, 36)

            CreateNotification("Bản quyền hết hạn", "Key đã hết hạn!", "Cảnh báo", 4)
        else
            ServerStatusLbl.Text = "Server Status: INVALID KEY"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(239, 68, 68)
            LicenseExpLbl.Text = "License Expiration: --"

            CreateNotification("Xác thực thất bại", "Key không hợp lệ!", "Thất bại", 4)
        end
    end)
end

