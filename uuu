local function ApplyPlayerVisual(plr)
    if plr == LocalPlayer then return end
    ClearPlayerVisual(plr)
    if not AppState.EspEnabled then return end

    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not hum then return end

    local entry = {}

    if AppState.EspHighlight then
        local hl = Instance.new("Highlight")
        hl.Name = "ANDZ_Highlight"
        hl.FillColor = AppState.EspColor
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = AppState.EspTransparency
        hl.OutlineTransparency = 0.2
        hl.Adornee = char
        hl.Parent = char
        entry.Highlight = hl
    end

    local bb = Instance.new("BillboardGui")
    bb.Name = "ANDZ_Tag"
    bb.Size = UDim2.new(0, 180, 0, 54)
    bb.StudsOffset = Vector3.new(0, 2.8, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = head

    local InfoTxt = Instance.new("TextLabel")
    InfoTxt.Size = UDim2.new(1, 0, 0, 34)
    InfoTxt.BackgroundTransparency = 1
    InfoTxt.Font = Enum.Font.GothamBold
    InfoTxt.TextColor3 = AppState.EspColor
    InfoTxt.TextStrokeTransparency = 0.3
    InfoTxt.TextSize = 12
    InfoTxt.Text = plr.DisplayName
    InfoTxt.Parent = bb

    local HpBg = Instance.new("Frame")
    HpBg.Size = UDim2.new(0.7, 0, 0, 5)
    HpBg.Position = UDim2.new(0.15, 0, 0, 36)
    HpBg.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    HpBg.BorderSizePixel = 0
    HpBg.Visible = AppState.EspShowHealth
    HpBg.Parent = bb
    Instance.new("UICorner", HpBg).CornerRadius = UDim.new(1, 0)

    local HpFill = Instance.new("Frame")
    HpFill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
    HpFill.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
    HpFill.BorderSizePixel = 0
    HpFill.Parent = HpBg
    Instance.new("UICorner", HpFill).CornerRadius = UDim.new(1, 0)

    entry.Billboard = bb
    entry.InfoLabel = InfoTxt
    entry.HpBg = HpBg
    entry.HpFill = HpFill
