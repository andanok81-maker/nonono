--// Tự động tính toán Scale cho Mobile và PC
local function CalculateAutoScale()
    local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
    if viewport.X < 750 or viewport.Y < 500 then
        return math.clamp(viewport.X / 820, 0.62, 0.88)
    end
    return 1.0
end
