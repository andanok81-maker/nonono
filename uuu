--// Vòng lặp RenderStepped nhẹ cho FPS, Ping & Hiển thị thử nghiệm
local frameCounter = 0
local lastStatUpdate = os.clock()

TrackConnection(RunService.RenderStepped:Connect(function()
    if not AppState.Authenticated then return end

    frameCounter += 1
    local now = os.clock()
    if (now - lastStatUpdate) >= 0.6 then
        local fps = math.floor(frameCounter / (now - lastStatUpdate) + 0.5)
        frameCounter = 0
        lastStatUpdate = now

        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
        end)

        FpsLbl:SetText("FPS hiện tại: " .. tostring(fps) .. " FPS")
        PingLbl:SetText("Độ trễ mạng: " .. tostring(ping) .. " ms")
        ServerInfoLbl:SetText("Máy chủ: PlaceId " .. tostring(game.PlaceId) .. " | Số người chơi: " .. #Players:GetPlayers())
    end

    if AppState.EspEnabled then
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        for plr, visual in pairs(ActiveVisuals) do
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if root and hum and visual.InfoLabel then
                local parts = {}
                if AppState.EspShowName then
                    table.insert(parts, plr.DisplayName)
                end
                if AppState.EspShowDistance and myRoot then
                    local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                    table.insert(parts, "[" .. dist .. "m]")
                end
                visual.InfoLabel.Text = table.concat(parts, " ")
                if visual.HpFill then
                    visual.HpFill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
                end
            end
        end
    end
end))

