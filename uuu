--// Hỗ trợ âm thanh UI nhẹ nhàng
local function PlayUISound(soundId, volume)
    if not AppState.EnableSound then return end
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = soundId or "rbxassetid://6895079853"
        sound.Volume = volume or 0.35
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        task.delay(1.5, function()
            sound:Destroy()
        end)
    end)
end

--// Hỗ trợ Tween mượt mà
local function TweenObj(instance, props, duration, style, direction)
    if not instance then return end
    local time = AppState.EnableAnimation and (duration or 0.25) or 0.01
    local tweenInfo = TweenInfo.new(
        time,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(instance, tweenInfo, props)
    tween:Play()
    return tween
end

--// Lấy HWID an toàn trên nhiều môi trường
local function GetHardwareId()
    local ok, hwid = pcall(function()
        if gethwid then return gethwid() end
        if get_hwid then return get_hwid() end
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and hwid and tostring(hwid) ~= "" then
        return tostring(hwid)
    end
    return "ANDZ_" .. tostring(LocalPlayer.UserId)
end

--// Gửi HTTP Request đa nền tảng (Executor / Studio fallback)
local function SendHttpRequest(url, method, headers, body)
    local reqFunc = (syn and syn.request) or (http and http.request) or http_request or request
    if reqFunc then
        return pcall(function()
            return reqFunc({
                Url = url,
                Method = method or "GET",
                Headers = headers or {},
                Body = body
            })
        end)
    else
        return pcall(function()
            local resBody = HttpService:GetAsync(url)
            return { StatusCode = 200, Body = resBody, Success = true }
        end)
    end
end

