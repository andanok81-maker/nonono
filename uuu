        return
    end
    local rawName = WaypointNameInput:GetText()
    local name = (rawName and rawName:match("%S")) and rawName or ("Vị trí #" .. tostring(math.random(100, 999)))
    SavedWaypoints[name] = root.CFrame
    SelectedWaypointName = name
    WaypointDropdown:Refresh(GetWaypointNames())
