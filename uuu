                local ValLbl = Instance.new("TextLabel")
                ValLbl.Size = UDim2.new(0, 64, 0, 22)
                ValLbl.Position = UDim2.new(1, -74, 0, 5)
                ValLbl.BackgroundTransparency = 1
                ValLbl.Font = Enum.Font.GothamBold
                ValLbl.Text = tostring(currentVal)
                ValLbl.TextColor3 = Color3.fromRGB(192, 132, 252)
                ValLbl.TextSize = 13
                ValLbl.TextXAlignment = Enum.TextXAlignment.Right
                ValLbl.Parent = Box

                local Track = Instance.new("TextButton")
                Track.Size = UDim2.new(1, -24, 0, 8)
                Track.Position = UDim2.new(0, 12, 0, 34)
                Track.BackgroundColor3 = Color3.fromRGB(42, 48, 74)
                Track.Text = ""
                Track.AutoButtonColor = false
                Track.Parent = Box
                Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

                local Fill = Instance.new("Frame")
                local initPct = (currentVal - minVal) / math.max(maxVal - minVal, 0.001)
                Fill.Size = UDim2.new(initPct, 0, 1, 0)
                Fill.BackgroundColor3 = AppState.PrimaryColor
                Fill.BorderSizePixel = 0
                Fill.Parent = Track
                Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
                table.insert(Window.ThemeObjects, { Object = Fill, Property = "BackgroundColor3" })

                local sliding = false

                local function UpdateSliderFromX(inputX)
                    local relX = math.clamp((inputX - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
                    local rawVal = minVal + (maxVal - minVal) * relX
                    -- Hỗ trợ số thập phân nếu khoảng nhỏ
                    if (maxVal - minVal) <= 5 then
                        currentVal = math.floor(rawVal * 100 + 0.5) / 100
                    else
                        currentVal = math.floor(rawVal + 0.5)
                    end
                    ValLbl.Text = tostring(currentVal)
                    Fill.Size = UDim2.new(relX, 0, 1, 0)
                    if callback then
                        pcall(callback, currentVal)
                    end
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        UpdateSliderFromX(input.Position.X)
                    end
                end)

                TrackConnection(UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateSliderFromX(input.Position.X)
                    end
                end))

                TrackConnection(UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end))

                return {
                    SetValue = function(_, val)
                        currentVal = math.clamp(val, minVal, maxVal)
                        local pct = (currentVal - minVal) / math.max(maxVal - minVal, 0.001)
                        ValLbl.Text = tostring(currentVal)
                        TweenObj(Fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.15)
                        if callback then pcall(callback, currentVal) end
                    end
                }
            end

