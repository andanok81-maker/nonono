local function ClampColor(c)
    return Color3.new(
        math.clamp(c.R, 0, 1),
        math.clamp(c.G, 0, 1),
        math.clamp(c.B, 0, 1)
    )
end

local function ApplyBrightness(color, delta)
    return ClampColor(Color3.new(color.R + delta, color.G + delta, color.B + delta))
end

local function ColorToHex(c)
    local r = math.clamp(math.floor(c.R * 255 + 0.5), 0, 255)
    local g = math.clamp(math.floor(c.G * 255 + 0.5), 0, 255)
    local b = math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)
    return string.format("#%02X%02X%02X", r, g, b)
end

local function HexToColor(hex)
    if type(hex) ~= "string" then return nil end
    local clean = hex:gsub("#", ""):gsub("%s+", "")
    if #clean ~= 6 or clean:match("[^0-9A-Fa-f]") then return nil end
    local r = tonumber(clean:sub(1, 2), 16)
    local g = tonumber(clean:sub(3, 4), 16)
    local b = tonumber(clean:sub(5, 6), 16)
    return Color3.fromRGB(r, g, b)
end

local function PlaySoundEffect(id, vol)
    if not State.NotifConfig.Sound or State.LiteMode then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id or "rbxassetid://6895079853"
        s.Volume = vol or 0.3
        s.Parent = SoundService
        s:Play()
        task.delay(1.2, function()
            if s then s:Destroy() end
        end)
    end)
end

local function Tween(inst, goal, duration, style, dir)
    if not inst or not inst.Parent then return end
    local dur = (State.Theme.AnimSpeed and not State.LiteMode) and (duration or State.Theme.AnimSpeed) or 0.01
    local info = TweenInfo.new(dur, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(inst, info, goal)
    tw:Play()
    return tw
end

function ThemeManager:Bind(obj, prop, role)
    table.insert(self.BoundObjects, { Obj = obj, Prop = prop, Role = role })
end

function ThemeManager:GetRoleColor(role)
    local b = State.Theme.Brightness or 0
    if role == "Primary" then return ApplyBrightness(State.Theme.Primary, b)
    elseif role == "Accent" then return ApplyBrightness(State.Theme.Accent, b)
    elseif role == "Background" then return ApplyBrightness(State.Theme.Background, b)
    elseif role == "Border" then return ApplyBrightness(State.Theme.Border, b)
    elseif role == "Text" then return ApplyBrightness(State.Theme.Text, b)
    end
    return State.Theme.Primary
end

function ThemeManager:Refresh()
    for i = #self.BoundObjects, 1, -1 do
        local item = self.BoundObjects[i]
        if not item.Obj or not item.Obj.Parent then
            table.remove(self.BoundObjects, i)
        else
            if item.Prop == "Transparency" then
                Tween(item.Obj, { BackgroundTransparency = State.Theme.BgTransparency }, 0.2)
            elseif item.Prop == "CornerRadius" then
                item.Obj.CornerRadius = UDim.new(0, State.Theme.CornerRadius)
            else
                Tween(item.Obj, { [item.Prop] = self:GetRoleColor(item.Role) }, 0.2)
            end
        end
    end
end

function HistoryManager:PushAction(text)
    local entry = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(text))
    table.insert(State.ActionHistory, 1, entry)
    if #State.ActionHistory > 60 then
        table.remove(State.ActionHistory)
    end
    table.insert(State.ActivityLog, 1, entry)
    if #State.ActivityLog > 80 then
        table.remove(State.ActivityLog)
    end
end

local function CountActiveFeatures()
    local count = 0
    if State.SprintEnabled then count += 1 end
    if State.Visual.Enabled then count += 1 end
    if State.Island.Enabled then count += 1 end
    if State.AutoSaveEnabled then count += 1 end
    for _, v in pairs(State.Automation) do
        if type(v) == "boolean" and v then
            count += 1
        end
    end
    return count
end

