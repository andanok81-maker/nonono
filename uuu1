    Tween(MainScale, { Scale = GetAutoScale() }, 0.28, Enum.EasingStyle.Back)
    IslandManager:SyncSettings()
    HistoryManager:PushAction("Đăng nhập thành công vào ANDZ PREMIUM V3")
end

local function AttemptLogin()
    if verifyingNow then return end
    local key = KeyBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if key == "" then
        ServerStatusLbl.Text = "Server Status: WAITING FOR VERIFICATION"
        ServerStatusLbl.TextColor3 = Color3.fromRGB(245, 158, 11)
        NotificationManager:Notify("Xác thực", "Vui lòng nhập key!", "Cảnh báo", 3)
        return
    end

    verifyingNow = true
    ServerStatusLbl.Text = "Server Status: VERIFYING..."
    ServerStatusLbl.TextColor3 = Color3.fromRGB(96, 165, 250)
    NotificationManager:Notify("Xác thực", "Đang xác minh key...", "Hệ thống", 2.5)

    task.spawn(function()
        local url = string.format(
            "%s?key=%s&hwid=%s&user_id=%s",
            ANDZ_V3.ApiUrl,
            HttpService:UrlEncode(key),
            HttpService:UrlEncode(GetHwidSafe()),
            tostring(LocalPlayer.UserId)
        )
        local ok, data = HttpGetJson(url)
        verifyingNow = false

        if not ok or not data then
            ServerStatusLbl.Text = "Server Status: CONNECTION ERROR"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(239, 68, 68)
            State.ApiLastStatus = "Lỗi kết nối"
            NotificationManager:Notify("Lỗi mạng", "Không thể kết nối máy chủ!", "Lỗi", 3.5)
            return
        end

        local st = tostring(data.status or data.state or ""):lower()
        local msg = tostring(data.message or data.msg or ""):lower()
        local valid = (data.success == true) or (data.valid == true) or st == "valid" or st == "success" or st == "active" or st == "ok"
        local expired = (data.expired == true) or st == "expired" or (msg:find("expir") ~= nil) or (msg:find("hết hạn") ~= nil)
        local expVal = data.expires_at or data.expiry or data.expire or data.time_left or "Không giới hạn"

        if valid and not expired then
            State.LicenseKey = key
            ServerStatusLbl.Text = "Server Status: CONNECTED"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(34, 197, 94)
            ExpireStatusLbl.Text = "License Expiration: " .. tostring(expVal)
            ExpireStatusLbl.TextColor3 = Color3.fromRGB(74, 222, 128)
            NotificationManager:Notify("Thành công", "Đăng nhập thành công!", "Thành công", 3)
            task.wait(0.6)
            UnlockMainMenu(expVal)
        elseif expired then
            ServerStatusLbl.Text = "Server Status: KEY EXPIRED"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(245, 158, 11)
            ExpireStatusLbl.Text = "License Expiration: " .. tostring(expVal)
            NotificationManager:Notify("Hết hạn", "Key đã hết hạn!", "Cảnh báo", 3.5)
        else
            ServerStatusLbl.Text = "Server Status: INVALID KEY"
            ServerStatusLbl.TextColor3 = Color3.fromRGB(239, 68, 68)
            NotificationManager:Notify("Thất bại", "Key không hợp lệ!", "Lỗi", 3.5)
        end
    end)
end

