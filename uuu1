TrackConn(Players.PlayerRemoving:Connect(function(p)
    if Registry.Visuals[p] then
        if Registry.Visuals[p].Highlight then pcall(function() Registry.Visuals[p].Highlight:Destroy() end) end
        if Registry.Visuals[p].Billboard then pcall(function() Registry.Visuals[p].Billboard:Destroy() end) end
        Registry.Visuals[p] = nil
    end
end))

local framesAcc = 0
local lastTick = os.clock()

local PerfUiCallbacks = {}

TrackConn(RunService.RenderStepped:Connect(function()
    framesAcc += 1
    local now = os.clock()
    if (now - lastTick) >= 0.5 then
        local fps = math.floor(framesAcc / (now - lastTick) + 0.5)
        framesAcc = 0
        lastTick = now

        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
        end)

        if fps > 0 and fps < LowestFps then LowestFps = fps end
        table.insert(FpsSamples, fps)
        table.insert(PingSamples, ping)
        if #FpsSamples > 40 then table.remove(FpsSamples, 1) end
        if #PingSamples > 40 then table.remove(PingSamples, 1) end

        local sumF, sumP = 0, 0
        for _, v in ipairs(FpsSamples) do sumF += v end
        for _, v in ipairs(PingSamples) do sumP += v end
        local avgF = #FpsSamples > 0 and math.floor(sumF / #FpsSamples + 0.5) or fps
        local avgP = #PingSamples > 0 and math.floor(sumP / #PingSamples + 0.5) or ping

        local elapsed = math.floor(now - State.SessionStart)
        local hh = math.floor(elapsed / 3600)
        local mm = math.floor((elapsed % 3600) / 60)
        local ss = elapsed % 60
        local upStr = string.format("%02d:%02d:%02d", hh, mm, ss)

        IslandManager:UpdateTelemetry(fps, ping)

        if State.Authenticated and State.Automation.AutoUpdateDashboard then
            LblFps:SetText("FPS trực tiếp: " .. tostring(fps) .. " FPS")
            LblPing:SetText("Ping trực tiếp: " .. tostring(ping) .. " ms")
            LblUptime:SetText("Thời gian hoạt động: " .. upStr)
            if State.Automation.AutoUpdateClock then
                LblClock:SetText("Đồng hồ thời gian thực: " .. os.date("%H:%M:%S"))
            end
            local bars = math.clamp(math.floor(fps / 6), 1, 10)
            LblPerfChart:SetText("Biểu đồ hiệu suất: [" .. string.rep("■", bars) .. string.rep("·", 10 - bars) .. "]")
            LblServer:SetText("Máy chủ: PlaceId " .. tostring(game.PlaceId) .. " | Người chơi: " .. #Players:GetPlayers())
            LblActiveCount:SetText("Chức năng đang bật: " .. tostring(CountActiveFeatures()))
            LblActiveCfg:SetText("Cấu hình hiện tại: " .. State.ActiveProfile .. " | Theme: " .. State.Theme.Name)
            LblRecentAct:SetText("Thao tác gần đây: " .. (State.ActionHistory[1] or "Chưa có"))
            LblActHist:SetText("Lịch sử hoạt động: " .. tostring(#State.ActivityLog) .. " bản ghi")
        end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if root then
            LblPos:SetText(string.format("Tọa độ X, Y, Z: %.1f, %.1f, %.1f", root.Position.X, root.Position.Y, root.Position.Z))
        end
        if hum then
            LblSpeed:SetText("Tốc độ di chuyển: " .. tostring(math.floor(hum.WalkSpeed * 10) / 10))
            LblJumpState:SetText("Trạng thái nhảy: " .. (hum.Jump and "Đang nhảy" or "Sẵn sàng"))
            LblCharState:SetText("Trạng thái nhân vật: " .. (hum.Health > 0 and "Sống" or "Gục"))
            LblHealth:SetText(string.format("Sức khỏe: %d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth)))
            LblHumState:SetText("Trạng thái Humanoid: " .. hum:GetState().Name)
        end
        LblRespawnTrack:SetText("Theo dõi hồi sinh: Số lần hồi sinh = " .. tostring(RespawnCounter))
        LblMoveCur:SetText(string.format("Thông số hiện tại: Walk=%d | Sprint=%d | Jump=%d | FOV=%d", State.WalkSpeed, State.SprintSpeed, State.JumpPower, State.FieldOfView))

        if State.SelectedWaypoint and State.Waypoints[State.SelectedWaypoint] and root then
            local wp = State.Waypoints[State.SelectedWaypoint]
            local d = math.floor((root.Position - Vector3.new(wp[1], wp[2], wp[3])).Magnitude)
            LblWpDist:SetText("Khoảng cách tới điểm chọn: " .. tostring(d) .. " studs (" .. tostring(State.SelectedWaypoint) .. ")")
        else
            LblWpDist:SetText("Khoảng cách tới điểm chọn: --")
        end

        if State.Visual.Enabled and root then
            for plr, vis in pairs(Registry.Visuals) do
                local pChar = plr.Character
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
                if pRoot and pHum and vis.Label then
                    local parts = {}
                    if State.Visual.ShowName then table.insert(parts, plr.DisplayName) end
                    if State.Visual.ShowDistance then
                        table.insert(parts, "[" .. math.floor((root.Position - pRoot.Position).Magnitude) .. "m]")
                    end
                    if State.Visual.ShowCharInfo then
                        table.insert(parts, "(" .. math.floor(pHum.Health) .. "HP)")
                    end
                    vis.Label.Text = table.concat(parts, " ")
                    if vis.HpBg then vis.HpBg.Visible = State.Visual.ShowHealth end
                    if vis.HpFill then
                        vis.HpFill.Size = UDim2.new(math.clamp(pHum.Health / math.max(pHum.MaxHealth, 1), 0, 1), 0, 1, 0)
                    end
                end
            end
        end

        for _, cb in ipairs(PerfUiCallbacks) do
            pcall(cb, fps, ping, avgF, LowestFps == 999 and fps or LowestFps, avgP, upStr)
        end
    end
end))

