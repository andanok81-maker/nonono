local TabsRegistry = {}
local CommandRegistry = {}

local function RegisterCommand(name, desc, fn)
    table.insert(CommandRegistry, { Name = name, Desc = desc, Run = fn })
end

local function SelectTabByName(tabName)
    local target = TabsRegistry[tabName]
    if not target then return end
    State.CurrentTabName = tabName
    for name, t in pairs(TabsRegistry) do
        local active = (name == tabName)
        t.Page.Visible = active
        Tween(t.Btn, { BackgroundTransparency = active and 0.22 or 1 }, 0.16)
        Tween(t.Label, { TextColor3 = active and Color3.new(1, 1, 1) or Color3.fromRGB(165, 176, 206) }, 0.16)
    end
    if State.NotifConfig.Animation and not State.LiteMode then
        target.Page.Position = UDim2.new(0, 22, 0, 8)
        Tween(target.Page, { Position = UDim2.new(0, 10, 0, 8) }, 0.18)
    end
end

