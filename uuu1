                        chosen = item
                        open = false
                        chosenLbl.Text = tostring(chosen) .. " ▼"
                        Tween(frame, { Size = UDim2.new(1, 0, 0, 34) }, 0.18)
                        if cb then pcall(cb, chosen) end
