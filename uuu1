local V_Main = VisTab:CreateSection("Thành phần hiển thị thử nghiệm")
local function ClearVisuals()
    for _, v in pairs(Registry.Visuals) do
        if v.Highlight then pcall(function() v.Highlight:Destroy() end) end
        if v.Billboard then pcall(function() v.Billboard:Destroy() end) end
    end
    table.clear(Registry.Visuals)
end

local function BuildVisualForPlayer(plr)
    if plr == LocalPlayer or not State.Visual.Enabled then return end
    if Registry.Visuals[plr] then
        if Registry.Visuals[plr].Highlight then pcall(function() Registry.Visuals[plr].Highlight:Destroy() end) end
        if Registry.Visuals[plr].Billboard then pcall(function() Registry.Visuals[plr].Billboard:Destroy() end) end
    end
    local char = plr.Character
    local head = char and char:FindFirstChild("Head")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not head or not hum then return end

    local entry = {}
    if State.Visual.Highlight then
        entry.Highlight = CreateInst("Highlight", {
            FillColor = State.Visual.Color,
            OutlineColor = Color3.new(1, 1, 1),
            FillTransparency = State.Visual.Transparency,
            Adornee = char
        }, char)
    end

    local bb = CreateInst("BillboardGui", {
        Size = UDim2.new(0, 190, 0, 58),
        StudsOffset = Vector3.new(0, 2.8, 0),
        AlwaysOnTop = true,
        Adornee = head
    }, head)

    entry.Billboard = bb
    entry.Label = CreateInst("TextLabel", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextColor3 = State.Visual.Color,
        TextStrokeTransparency = 0.25,
        TextSize = State.Visual.TextSize,
        Text = plr.DisplayName
    }, bb)

    entry.HpBg = CreateInst("Frame", {
        Size = UDim2.new(0.7, 0, 0, 5),
        Position = UDim2.new(0.15, 0, 0, 40),
        BackgroundColor3 = Color3.fromRGB(20, 22, 35),
        BorderSizePixel = 0,
        Visible = State.Visual.ShowHealth
    }, bb)
    CreateInst("UICorner", { CornerRadius = UDim.new(1, 0) }, entry.HpBg)

    entry.HpFill = CreateInst("Frame", {
        Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(34, 197, 94),
        BorderSizePixel = 0
    }, entry.HpBg)
    CreateInst("UICorner", { CornerRadius = UDim.new(1, 0) }, entry.HpFill)

    Registry.Visuals[plr] = entry
end

local function SyncVisuals()
    if not State.Visual.Enabled then
        ClearVisuals()
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then BuildVisualForPlayer(p) end
    end
end

