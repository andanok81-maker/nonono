local function GetHwidSafe()
    local ok, id = pcall(function()
        if gethwid then return gethwid() end
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    return (ok and id and tostring(id) ~= "") and tostring(id) or ("ANDZ_" .. tostring(LocalPlayer.UserId))
end

local function HttpGetJson(url)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok, res = pcall(function()
            return req({ Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
        end)
        if ok and res and res.Body then
            local pOk, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if pOk and type(decoded) == "table" then return true, decoded end
        end
        return false, nil
    end
    local ok, body = pcall(function() return HttpService:GetAsync(url) end)
    if ok and body then
        local pOk, decoded = pcall(function() return HttpService:JSONDecode(body) end)
        if pOk and type(decoded) == "table" then return true, decoded end
    end
    return false, nil
end

local function UnlockMainMenu(expStr)
    State.Authenticated = true
    State.LicenseStatus = "CONNECTED"
    State.LicenseExpiry = tostring(expStr or "Active")
    State.ApiLastStatus = "Đã kết nối"
