    if hum then
        hum.WalkSpeed = State.SprintEnabled and State.SprintSpeed or State.WalkSpeed
        hum.UseJumpPower = true
        hum.JumpPower = State.JumpPower
    end
end))

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        TrackConn(p.CharacterAdded:Connect(function()
            task.wait(0.25)
            if State.Visual.Enabled then BuildVisualForPlayer(p) end
        end))
