        return
    end

    if not State.MenuOpen then
        IslandGui.Visible = true
        if State.Island.Animation and not State.LiteMode then
            IslandScale.Scale = State.Island.Scale * 0.85
            Tween(IslandScale, { Scale = State.Island.Scale }, 0.22, Enum.EasingStyle.Back)
        end
    else
        IslandGui.Visible = false
        MiniDashFrame.Visible = false
        State.Island.MiniOpen = false
    end
end

