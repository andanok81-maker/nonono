--// Registry quản lý tài nguyên để Cleanup sạch sẽ
local Registry = {
    Connections = {},
    Instances = {},
    Visuals = {},
    ActiveThreads = {}
}

local function TrackConn(conn)
    if conn then
        table.insert(Registry.Connections, conn)
    end
    return conn
end

local function TrackInst(inst)
    if inst then
        table.insert(Registry.Instances, inst)
    end
    return inst
end

local function CreateInst(className, props, parent)
    local obj = Instance.new(className)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then
                pcall(function() obj[k] = v end)
            end
        end
    end
    if parent then
        obj.Parent = parent
    end
    return TrackInst(obj)
end

